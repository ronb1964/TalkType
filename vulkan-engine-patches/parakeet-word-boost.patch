+// TuxTalk: the user's words for the greedy decoder (see parakeet_set_word_boost).
+// Target k is one spelling of one word; its positions are
+// target_pos_begin[k] .. target_pos_begin[k+1]-1, and position p fits the
+// pieces entry_pid[e] (moving to local position entry_next[e]) for
+// e in pos_entry_begin[p] .. pos_entry_begin[p+1]-1.
+struct parakeet_word_boost {
+    std::vector<int> target_pos_begin;
+    std::vector<int> pos_entry_begin;
+    std::vector<int> entry_pid;
+    std::vector<int> entry_next;
+    float start_margin = 6.0f;
+    float step_margin  = 6.0f;
+    float blank_margin = 3.0f;
+    float word_budget  = 8.0f;
+    int   max_frames   = 30;
+    int   max_tries    = 3;
+
+    bool active() const { return target_pos_begin.size() > 1; }
+    int  n_targets() const { return (int) target_pos_begin.size() - 1; }
+    int  length(int k) const { return target_pos_begin[k + 1] - target_pos_begin[k]; }
+};

+int parakeet_set_word_boost(
+        struct parakeet_context * ctx,
+                          int   n_targets,
+                    const int * target_pos_begin,
+                          int   n_pos,
+                    const int * pos_entry_begin,
+                          int   n_entries,
+                    const int * entry_pid,
+                    const int * entry_next,
+                  const float * settings,
+                          int   n_settings) {
+    auto & wb = ctx->word_boost;
+    wb = parakeet_word_boost();
+    if (n_targets <= 0) {
+        return 0;
+    }
+    if (!target_pos_begin || !pos_entry_begin || !entry_pid || !entry_next || n_pos <= 0 || n_entries <= 0 ||
+        target_pos_begin[0] != 0 || target_pos_begin[n_targets] != n_pos ||
+        pos_entry_begin[0] != 0 || pos_entry_begin[n_pos] != n_entries) {
+        return -1;
+    }
+    for (int k = 0; k < n_targets; ++k) {
+        if (target_pos_begin[k + 1] <= target_pos_begin[k]) {
+            return -1;
+        }
+    }
+    for (int p = 0; p < n_pos; ++p) {
+        if (pos_entry_begin[p + 1] < pos_entry_begin[p]) {
+            return -1;
+        }
+    }
+    wb.target_pos_begin.assign(target_pos_begin, target_pos_begin + n_targets + 1);
+    wb.pos_entry_begin.assign(pos_entry_begin, pos_entry_begin + n_pos + 1);
+    wb.entry_pid.assign(entry_pid, entry_pid + n_entries);
+    wb.entry_next.assign(entry_next, entry_next + n_entries);
+    if (settings && n_settings >= 6) {
+        wb.start_margin = settings[0];
+        wb.step_margin  = settings[1];
+        wb.blank_margin = settings[2];
+        wb.word_budget  = settings[3];
+        wb.max_frames   = (int) settings[4];
+        wb.max_tries    = (int) settings[5];
+    }
+    return n_targets;
+}
+

+// TuxTalk: the prediction network's memory (LSTM h/c, its output) and the
+// last joint logits, so a word tried on a branch can be taken back.
+struct parakeet_decoder_snapshot {
+    std::vector<std::vector<float>> h;
+    std::vector<std::vector<float>> c;
+    std::vector<float> pred_out;
+    std::vector<float> logits;
+};
+
+static void parakeet_tensor_save(struct ggml_tensor * t, std::vector<float> & out) {
+    out.resize(ggml_nelements(t));
+    ggml_backend_tensor_get(t, out.data(), 0, ggml_nbytes(t));
+}
+
+static void parakeet_tensor_load(struct ggml_tensor * t, const std::vector<float> & in) {
+    ggml_backend_tensor_set(t, in.data(), 0, ggml_nbytes(t));
+}
+
+static void parakeet_decoder_save(parakeet_state & pstate, parakeet_decoder_snapshot & snap) {
+    const size_t n = pstate.lstm_state.layer.size();
+    snap.h.resize(n);
+    snap.c.resize(n);
+    for (size_t il = 0; il < n; ++il) {
+        parakeet_tensor_save(pstate.lstm_state.layer[il].h_state, snap.h[il]);
+        parakeet_tensor_save(pstate.lstm_state.layer[il].c_state, snap.c[il]);
+    }
+    parakeet_tensor_save(pstate.pred_out, snap.pred_out);
+    snap.logits = pstate.logits;
+}
+
+static void parakeet_decoder_load(parakeet_state & pstate, const parakeet_decoder_snapshot & snap) {
+    for (size_t il = 0; il < snap.h.size(); ++il) {
+        parakeet_tensor_load(pstate.lstm_state.layer[il].h_state, snap.h[il]);
+        parakeet_tensor_load(pstate.lstm_state.layer[il].c_state, snap.c[il]);
+    }
+    parakeet_tensor_load(pstate.pred_out, snap.pred_out);
+    pstate.logits = snap.logits;
+}

[Desktop Entry]
Name=TuxTalk
Comment=Hold a key, talk, and your words are typed for you
Exec=AppRun tray
Icon=io.github.ronb1964.TuxTalk
Type=Application
Categories=Utility;AudioVideo;Audio;Accessibility;
Terminal=false
StartupNotify=false
Actions=Preferences;TranscribeFile;Help;Quit;

[Desktop Action Preferences]
Name=Preferences
Exec=AppRun --open preferences

[Desktop Action TranscribeFile]
Name=Transcribe a File
Exec=AppRun --open transcribe

[Desktop Action Help]
Name=Help
Exec=AppRun --open help

[Desktop Action Quit]
Name=Quit TuxTalk
Exec=AppRun --quit

#!/bin/sh
# In-sandbox entry point for the TalkType Flatpak.
# The bundled Python deps live under /app/lib/python3.12/site-packages; the app
# package lives at /app/lib/talktype. Backend B (portal hotkey + libei typing) is
# selected automatically because FLATPAK_ID is set.
export PYTHONPATH="/app/lib:/app/lib/python3.13/site-packages:${PYTHONPATH}"
exec python3 -m talktype.tray "$@"
